# =============================================================================
# config.py.example — Copy this to config.py and fill in your credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Neo4j connection
# -----------------------------------------------------------------------------
NEO4J_URI      = "neo4j://localhost:7687"
NEO4J_USER     = "neo4j"
NEO4J_PASSWORD = "<your_neo4j_password>"
NEO4J_DATABASE = "learning"
MAX_NODES      = 20          # max nodes returned per label x keyword search

# -----------------------------------------------------------------------------
# Azure OpenAI
# -----------------------------------------------------------------------------
AZURE_KEY      = "<your_azure_openai_key>"
AZURE_VERSION  = "2024-12-01-preview"
AZURE_ENDPOINT = "https://<your_endpoint>.openai.azure.com/"
AZURE_MODEL    = "<your_model_deployment_name>"

# -----------------------------------------------------------------------------
# Stage 1 — Relevance Gate
# -----------------------------------------------------------------------------
CONFIDENCE_HIGH   = 0.8     # green — clear decision, proceed confidently
CONFIDENCE_MEDIUM = 0.6     # yellow — borderline, proceed with caution warning
# below CONFIDENCE_MEDIUM is considered low (red / uncertain)

# -----------------------------------------------------------------------------
# Stage 4 — Cypher Generation
# -----------------------------------------------------------------------------
CYPHER_DEFAULT_LIMIT = 25   # default LIMIT appended to generated Cypher queries
CYPHER_MAX_RETRIES   = 3    # max LLM retry attempts on rate-limit / connection errors

# -----------------------------------------------------------------------------
# Conversation
# -----------------------------------------------------------------------------
MAX_HISTORY = 5              # max conversation turns retained in context

# -----------------------------------------------------------------------------
# Stage 7 — Visualization
# -----------------------------------------------------------------------------
VIZ_ENABLED         = True  # set False to skip chart generation entirely
VIZ_LLM_ENABLED     = True  # use LLM planner for smart chart decisions (set False for heuristic-only)
VIZ_MIN_ROWS        = 3     # minimum rows to consider generating a chart
VIZ_MAX_PIE_CATS    = 10    # pie chart becomes unreadable above this
VIZ_OUTPUT_DIR      = "charts"  # directory for saved chart HTML files
VIZ_OPEN_BROWSER    = True  # auto-open chart in browser after generation
